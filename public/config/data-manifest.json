{
  "schema": "ghrab-data-manifest-v1",
  "appId": "generator",
  "appVersion": "7.1.24",
  "manifestVersion": 4,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true,
    "differentiationAiEgress": "structured identities and identifiers known from each group roster are replaced by Student A1/A2-style pseudonyms; free text also carries a UI warning because unknown names cannot be reliably detected"
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.generator.state.v1",
        "ghrab.generator.templates.v1",
        "ghrab.generator.history.v1",
        "ghrab.generator.theme.v1",
        "ghrab.generator.ai.model.v1",
        "ghrab.generator.ai.data-notice.v1",
        "ghrab.generator.onboarding-done.v1",
        "ghrab.generator.migration.p2-storage-namespace-v1.backup",
        "ghrab.generator.migration.p2-storage-namespace-v1.done",
        "ghrab.generator.legacy.*",
        "sestavovac_*",
        "genOnboardingDone_v1"
      ],
      "sensitivity": "potentially-personal",
      "authority": "generator-client",
      "clearOnEndWork": true,
      "note": "PC-01 verified. The full migration backup may contain the same work content/credentials as legacy storage and is therefore deleted. Lifecycle acknowledgement/status keys are reserved separately and are not content."
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.generator.ai.data-notice.v1",
        "ghrab.generator.welcome-shown.v1",
        "sestavovac_*",
        "genWelcomeShown_session"
      ],
      "sensitivity": "potentially-personal-session",
      "authority": "generator-client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.generator.ai.key.local.v1",
        "sestavovac_gemini_key",
        "ghrab.generator.security-code.v1",
        "sestavovac_school_security_code_v1"
      ],
      "sensitivity": "secret",
      "authority": "generator-client",
      "clearOnEndWork": true,
      "note": "Current P1 policy removes a legacy persistent Gemini key on load, but suite cleanup still treats any surviving canonical/legacy copy as secret."
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.generator.ai.key.session.v1",
        "sestavovac_gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "generator-client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "manual-preferences",
      "patterns": [
        "ghrab-manual-progress-test-generator-*",
        "ghrab-manual-theme"
      ],
      "sensitivity": "non-personal-settings",
      "authority": "manual-client",
      "clearOnEndWork": false,
      "note": "Interactive-manual progress/theme only; no test/student content."
    },
    {
      "kind": "localStorage",
      "category": "suite-session-lifecycle",
      "patterns": [
        "ghrab.generator.suite-session-seen.v1",
        "ghrab.generator.suite-session-status.v1"
      ],
      "sensitivity": "non-content-security-state",
      "authority": "generator-and-platform-lifecycle",
      "clearOnEndWork": false,
      "note": "Persistent lifecycle tombstones. Reserved from content deletion so replay is idempotent and F-02 states remain auditable."
    },
    {
      "kind": "localStorage",
      "category": "shared-suite-session-generation",
      "patterns": [
        "ghrab.platform.suite-session-generation.v1"
      ],
      "sensitivity": "non-content-security-state",
      "authority": "shared-platform-coordinator",
      "clearOnEndWork": false,
      "note": "Global Platform 1.1.2 generation tombstone. Generator reads it but never owns/rotates/deletes it."
    },
    {
      "kind": "localStorage",
      "category": "transient-handoff",
      "patterns": [
        "ghrab.platform.handoff.v2",
        "ghrab.handoff.v1"
      ],
      "sensitivity": "potentially-personal",
      "authority": "shared-platform-target-scoped",
      "clearOnEndWork": true,
      "note": "Generator cleanup deletes only a valid handoff whose target is generator; it never blindly removes a packet for another child."
    },
    {
      "kind": "localStorage",
      "category": "operational-telemetry",
      "patterns": [
        "ghrab.pilot.events.v2"
      ],
      "sensitivity": "non-content-operational-telemetry",
      "authority": "shared-platform",
      "clearOnEndWork": false,
      "note": "PC-01 verified current bridge records only allow-listed handoff metadata, not material content."
    },
    {
      "kind": "localStorage",
      "category": "shared-access-permit",
      "patterns": [
        "ghrab.access.permit.v2"
      ],
      "sensitivity": "credential-session",
      "authority": "AI-Studio/shared-access",
      "clearOnEndWork": false,
      "note": "Suite coordinator owns permit invalidation. Manual Generator end-work also removes it as a local convenience, but suite child cleanup does not claim ownership of this shared key."
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-generator-v*",
        "generator*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "generator-client",
      "clearOnEndWork": false,
      "note": "Service worker caches static/runtime assets only; PC-01 found no student/test content writer into Cache Storage."
    }
  ],
  "retention": {
    "defaultDays": null,
    "clientPolicy": "until-explicit-end-work-or-browser-site-data-clearing",
    "sessionEndsOnLogout": true,
    "serverLogsDays": null,
    "note": "Current GitHub/serverless profile has no app server retention job. School-server retention is a deployment policy and must be re-verified when connected."
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "csv",
      "html",
      "json",
      "pdf",
      "zip"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "clientControl": "ghrab-suite-session-v1 handler + generatorEndWork()",
    "serverEndpoint": null,
    "scope": "Generator-owned localStorage/sessionStorage, target=generator handoff packets and current-page in-memory test/file/roster/AI state; manual generatorEndWork additionally removes the shared access permit. Excludes other child namespaces, global suite generation tombstone, lifecycle acknowledgement/status, non-content telemetry and PWA cache."
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "GHRABPlatform.session.onEnd(...) via public/access/suite-session-cleanup.js; manual fallback generatorEndWork()"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.generator.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "generator-testu-zadani"
    ],
    "nativeFormats": [
      "json"
    ],
    "acceptsLegacyJson": false,
    "checksumRequiredForEnvelope": true,
    "maxBytes": 524288,
    "validation": "exact __type/formatVersion plus allowlisted state/DOM sanitization; uploaded binary source files are not embedded in this transfer format",
    "note": "This describes the teacher-to-teacher assignment-configuration JSON import. Other generated HTML/ZIP/result exports are not reimported through this path."
  },
  "ownership": {
    "localStorageRule": {
      "prefix": "ghrab.generator.",
      "legacyPrefixes": [
        "sestavovac_"
      ],
      "legacyExact": [
        "genOnboardingDone_v1"
      ],
      "reserved": [
        "ghrab.generator.suite-session-seen.v1",
        "ghrab.generator.suite-session-status.v1"
      ]
    },
    "sessionStorageRule": {
      "prefix": "ghrab.generator.",
      "legacyPrefixes": [
        "sestavovac_"
      ],
      "legacyExact": [
        "genWelcomeShown_session"
      ],
      "reserved": []
    },
    "sharedTargetScoped": [
      "ghrab.platform.handoff.v2",
      "ghrab.handoff.v1"
    ],
    "notOwned": [
      "ghrab.platform.suite-session-generation.v1",
      "ghrab.pilot.events.v2",
      "ghrab.access.permit.v2",
      "ghrab-manual-progress-test-generator-*",
      "ghrab-manual-theme"
    ],
    "note": "Runtime deletion uses the same Generator prefix/legacy rule with explicit lifecycle reservations. Shared handoff deletion is target-scoped."
  },
  "suiteSession": {
    "schema": "ghrab-suite-session-v1",
    "platformVersion": "1.1.2",
    "generationKey": "ghrab.platform.suite-session-generation.v1",
    "seenKey": "ghrab.generator.suite-session-seen.v1",
    "statusKey": "ghrab.generator.suite-session-status.v1",
    "handler": "public/access/suite-session-cleanup.js",
    "replay": true,
    "acknowledgement": "Platform seen key advances only after verified local cleanup; status distinguishes signal seen, cleanup complete and acknowledgement. Failed cleanup returns ok:false and must not advance seen.",
    "staleDocumentGuard": "per-document generation baseline plus persistence guards and pageshow/focus/visibility checks"
  }
}
